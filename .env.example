# ============================================================
# Capacity Connect — environment configuration
# ------------------------------------------------------------
# DEMO MODE (default): leave both values empty. The app runs on a
# fully simulated backend (localStorage) with realistic seed data —
# perfect for judging without any external service.
#
# PRODUCTION MODE: create a free project at https://supabase.com,
# run supabase/schema.sql and supabase/seed.sql in the SQL editor,
# then paste your project URL + PUBLISHABLE (anon) key below.
#
#   NEVER put the service-role key in this file or anywhere in the
#   frontend. Only the publishable/anon key belongs here — Row Level
#   Security (see supabase/schema.sql) protects all data.
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
